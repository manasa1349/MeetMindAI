MONGODB_URI=mongodb://localhost:27017/meetmind-ai
PORT=7000
NODE_ENV=development
FRONTEND_URL=http://localhost:2000
FRONTEND_URLS=http://localhost:2000,http://localhost:5173
COOKIE_SAMESITE=lax

# JWT secret used to sign access tokens. Replace in your local `.env` with a strong value.
# Do NOT commit your `.env` file to version control.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Example (do not use this exact value):
# JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional OpenAI transcription and summary configuration.
# Without OPENAI_API_KEY, raw audio-to-text falls back to safe mock/local output.
# OPENAI_API_KEY=your_api_key
# OPENAI_WHISPER_MODEL=whisper-1
# OPENAI_SUMMARY_MODEL=gpt-4o-mini

# Optional xAI/Grok meeting insight configuration.
# Grok is used for summary/action/entity/topic extraction, not raw audio transcription.
# XAI_API_KEY=your_xai_api_key
# XAI_SUMMARY_MODEL=grok-4
